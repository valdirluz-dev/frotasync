NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://frotasync_dev:replace_me@localhost:5433/frotasync?schema=public
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=15m

# SMTP local de desenvolvimento (Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FROTASYNC <no-reply@frotasync.local>

# Origens autorizadas a realizar operações autenticadas
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

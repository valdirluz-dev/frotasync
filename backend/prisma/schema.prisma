generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model codigo_verificacao {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id       String    @db.Uuid
  codigo_hash      String    @db.VarChar(255)
  expira_em        DateTime  @db.Timestamptz(6)
  tentativas       Int       @default(0) @db.SmallInt
  usado_em         DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  reset_token_hash String?   @unique(map: "uq_codigo_reset_token", where: raw("(reset_token_hash IS NOT NULL)")) @db.Char(64)
  reset_expira_em  DateTime? @db.Timestamptz(6)
  usuario          usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id, created_at], map: "idx_codigo_usuario_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documento {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidade_id          String    @db.Uuid
  nome                String    @db.VarChar(150)
  tipo                String?   @db.VarChar(60)
  categoria           String    @db.VarChar(40)
  data_emissao        DateTime? @db.Date
  data_validade       DateTime  @db.Date
  descricao           String?
  anexo_nome          String    @db.VarChar(255)
  anexo_url           String    @db.VarChar(500)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  anexo_tamanho_bytes BigInt
  anexo_tipo          String    @db.VarChar(100)
  unidade             unidade   @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoria], map: "idx_documento_categoria")
  @@index([data_validade], map: "idx_documento_data_validade")
  @@index([unidade_id], map: "idx_documento_unidade_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model empresa {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome_fantasia String    @db.VarChar(150)
  razao_social  String    @db.VarChar(200)
  cnpj          String    @unique(map: "uq_empresa_cnpj") @db.Char(14)
  segmento      String    @db.VarChar(100)
  tipo_unidade  String    @db.VarChar(10)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  cep           String    @db.Char(8)
  logradouro    String    @db.VarChar(150)
  numero        String    @db.VarChar(10)
  complemento   String?   @db.VarChar(100)
  bairro        String    @db.VarChar(100)
  cidade        String    @db.VarChar(100)
  uf            String    @db.Char(2)
  unidade       unidade[]
  usuario       usuario[]
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model historico_alteracao {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidade_id    String   @db.Uuid
  usuario_id    String?  @db.Uuid
  entidade      String   @db.VarChar(20)
  entidade_id   String   @db.Uuid
  acao          String   @db.VarChar(20)
  descricao     String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  entidade_nome String   @db.VarChar(150)
  unidade       unidade  @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario       usuario? @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_historico_created_at")
  @@index([unidade_id], map: "idx_historico_unidade_id")
}

model refresh_token {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String    @db.Uuid
  token_hash  String    @unique(map: "uq_refresh_token_hash") @db.Char(64)
  lembrar     Boolean   @default(false)
  expira_em   DateTime  @db.Timestamptz(6)
  revogado_em DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  usuario     usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_refresh_token_usuario_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tarefa {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidade_id     String    @db.Uuid
  titulo         String    @db.VarChar(150)
  descricao      String?
  status         String    @default("pendente") @db.VarChar(20)
  data_inicio    DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  prazo          DateTime  @db.Date
  data_conclusao DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  unidade        unidade   @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_tarefa_status")
  @@index([unidade_id], map: "idx_tarefa_unidade_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model unidade {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id          String                @db.Uuid
  nome                String                @db.VarChar(150)
  codigo              String                @db.VarChar(30)
  cep                 String                @db.Char(8)
  logradouro          String                @db.VarChar(150)
  numero              String                @db.VarChar(10)
  complemento         String?               @db.VarChar(100)
  bairro              String                @db.VarChar(100)
  cidade              String                @db.VarChar(100)
  uf                  String                @db.Char(2)
  descricao           String?
  status              String                @default("ativa") @db.VarChar(10)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  documento           documento[]
  historico_alteracao historico_alteracao[]
  tarefa              tarefa[]
  empresa             empresa               @relation(fields: [empresa_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_unidade_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuario {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id          String                @db.Uuid
  nome                String                @db.VarChar(150)
  cpf                 String                @unique(map: "uq_usuario_cpf") @db.Char(11)
  telefone            String                @db.VarChar(11)
  cargo               String                @db.VarChar(100)
  email               String                @unique(map: "uq_usuario_email") @db.VarChar(180)
  senha_hash          String                @db.VarChar(255)
  papel               String                @default("colaborador") @db.VarChar(20)
  aceite_termos_em    DateTime              @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  codigo_verificacao  codigo_verificacao[]
  historico_alteracao historico_alteracao[]
  refresh_token       refresh_token[]
  empresa             empresa               @relation(fields: [empresa_id], references: [id], onUpdate: NoAction)

  @@index([empresa_id], map: "idx_usuario_empresa_id")
}
